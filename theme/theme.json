{
  "$schema":"https://schemas.wp.org/trunk/theme.json",
  "version":3,
  "settings":{
     "appearanceTools":false,
     "useRootPaddingAwareAlignments":true,
     "lightbox":{
        "enabled":false
     },
     "shadow":{
        "defaultPresets":false
     },
     "spacing":{
        "blockGap":true,
        "margin":true,
        "padding":true,
        "customSpacingSize":false,
        "defaultSpacingSizes":true,
        "spacingScale":{"steps":0},
        "spacingSizes":[
           {"slug":"xs","name":"XS","size":"calc(var(--grid-gutter-height) / 2)"},
           {"slug":"s","name":"S","size":"var(--grid-gutter-height)"},
           {"slug":"m","name":"M","size":"var(--grid-gutter-width)"},
           {"slug":"l","name":"L","size":"calc(var(--grid-gutter-height) * 2)"},
           {"slug":"xl","name":"XL","size":"calc(var(--grid-gutter-height) * 3)"},
           {"slug":"2xl","name":"2XL","size":"calc(var(--grid-gutter-height) * 4)"},
           {"slug":"3xl","name":"3XL","size":"calc(var(--grid-gutter-height) * 5)"},
           {"slug":"4xl","name":"4XL","size":"calc(var(--grid-gutter-height) * 6)"},
           {"slug":"small","name":"Small","size":"0.75rem"},
           {"slug":"medium","name":"Medium","size":"1.5rem"},
           {"slug":"large","name":"Large","size":"3rem"}
        ]
     },
     "typography":{
        "dropCap":false,
        "customFontSize":false,
        "textTransform":false,
        "fontFamilies":[

        ],
        "letterSpacing":false,
        "fontStyle":false,
        "fontWeight":false,
        "lineHeight":false,
        "textDecoration":false,
        "fontSizes":[
           {
              "slug":"small",
              "name":"Small",
              "size":"var(--font-size-small)"
           },
           {
              "slug":"medium",
              "name":"Medium",
              "size":"var(--font-size-medium)"
           },
           {
              "slug":"large",
              "name":"Large",
              "size":"var(--font-size-large)"
           },
           {
              "slug":"larger",
              "name":"Larger",
              "size":"var(--font-size-larger)"
           }
        ]
     },
     "layout":{
        "allowCustomContentAndWideSize":false,
        "allowEditing":true,
        "contentSize":"var(--content-width)",
        "wideSize":"var(--wide-width)"
     },
     "color":{
        "defaultPalette":false,
        "defaultGradients":false,
        "custom":false,
        "customGradient":false,
        "defaultDuotone":false,
        "customDuotone":false,
        "palette":[
           {
              "name":"Primary 300",
              "slug":"primary-300",
              "color":"var(--color-primary-300)"
           },
           {
              "name":"Primary 500",
              "slug":"primary-500",
              "color":"var(--color-primary-500)"
           },
           {
              "name":"Primary 700",
              "slug":"primary-700",
              "color":"var(--color-primary-700)"
           },
           {
              "name":"Secondary 300",
              "slug":"secondary-300",
              "color":"var(--color-secondary-300)"
           },
           {
              "name":"Secondary 500",
              "slug":"secondary-500",
              "color":"var(--color-secondary-500)"
           },
           {
              "name":"Secondary 700",
              "slug":"secondary-700",
              "color":"var(--color-secondary-700)"
           },
           {
              "name":"Tertiary 300",
              "slug":"tertiary-300",
              "color":"var(--color-tertiary-300)"
           },
           {
              "name":"Tertiary 500",
              "slug":"tertiary-500",
              "color":"var(--color-tertiary-500)"
           },
           {
              "name":"Tertiary 700",
              "slug":"tertiary-700",
              "color":"var(--color-tertiary-700)"
           },
           {
              "name":"Gray 0",
              "slug":"gray-0",
              "color":"var(--color-gray-0)"
           },
           {
              "name":"Gray 100",
              "slug":"gray-100",
              "color":"var(--color-gray-100)"
           },
           {
              "name":"Gray 300",
              "slug":"gray-300",
              "color":"var(--color-gray-300)"
           },
           {
              "name":"Gray 500",
              "slug":"gray-500",
              "color":"var(--color-gray-500)"
           },
           {
              "name":"Gray 700",
              "slug":"gray-700",
              "color":"var(--color-gray-700)"
           },
           {
              "name":"Gray 900",
              "slug":"gray-900",
              "color":"var(--color-gray-900)"
           },
           {
              "name":"Gray 1000",
              "slug":"gray-1000",
              "color":"var(--color-gray-1000)"
           },
           {
              "name":"System Success",
              "slug":"system-success",
              "color":"var(--color-system-success)"
           },
           {
              "name":"System Warning",
              "slug":"system-warning",
              "color":"var(--color-system-warning)"
           },
           {
              "name":"System Error",
              "slug":"system-error",
              "color":"var(--color-system-error)"
           },
           {
              "name":"System Info",
              "slug":"system-info",
              "color":"var(--color-system-info)"
           }
        ]
     },
     "background":{
        "backgroundImage":false,
        "backgroundSize":false
     },
     "blocks": {
      "core/cover": {
        "color": {
          "heading": false
        }
      }
     }
  },
  "styles":{
     "blocks":{
        "core/group":{"spacing":{"padding":{"top":"var:preset|spacing|s","bottom":"var:preset|spacing|s","left":"var:preset|spacing|m","right":"var:preset|spacing|m"}}},
        "core/cover":{"spacing":{"padding":{"top":"var:preset|spacing|s","bottom":"var:preset|spacing|s","left":"var:preset|spacing|m","right":"var:preset|spacing|m"}}}
     },
     "spacing":{
        "blockGap":"var(--grid-gutter-height)",
        "padding":{"left":"var(--grid-gutter-width)","right":"var(--grid-gutter-width)"}
     },
     "filter":{
        "duotone":{

        }
     }
  }
}
